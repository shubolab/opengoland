+    private static void processUsages(@NotNull List<LSPUsagePsiElement> usages,
+                                      @NotNull SearchScope searchScope,
+                                      @NotNull Processor<? super Usage> processor) {
+        List<LSPUsagePsiElement> scopedUsages = new ArrayList<>();
+        for (var usage : usages) {
+            if (LSPIJUtils.getFile(usage) != null && isInScope(searchScope, usage)) {
+                scopedUsages.add(usage);
+            }
+        }
+        // Filter scope first: an out-of-scope item must not remove an in-scope
+        // result. Numeric text offsets are comparable only within one file.
+        for (var usage : scopedUsages) {
+            VirtualFile usageFile = LSPIJUtils.getFile(usage);
+            boolean containsMoreSpecificUsage = ContainerUtil.exists(scopedUsages, otherUsage -> {
+                if (usage == otherUsage || !Objects.equals(usageFile, LSPIJUtils.getFile(otherUsage))) {
+                    return false;
+                }
+                TextRange range = usage.getTextRange();
+                TextRange otherRange = otherUsage.getTextRange();
+                // Keep partial overlaps and equal ranges; preserve upstream's
+                // preference for the smaller strictly-contained range only.
+                return range != null && otherRange != null && range.contains(otherRange) && !range.equals(otherRange);
+            });
+            if (!containsMoreSpecificUsage) {
+                processor.process(new UsageInfo2UsageAdapter(new UsageInfo(usage)));
+            }
+        }
+    }
