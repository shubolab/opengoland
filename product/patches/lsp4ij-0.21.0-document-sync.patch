+    private static boolean isInScope(@NotNull SearchScope scope, @NotNull LSPUsagePsiElement usage) {
+        if (scope instanceof LocalSearchScope localScope) {
+            // LSP elements are synthetic children of the file, so PSI ancestry
+            // cannot represent their containment in a selected local range.
+            PsiFile file = usage.getContainingFile();
+            TextRange range = usage.getTextRange();
+            return file != null && range != null && localScope.containsRange(file, range);
+        }
+        return PsiSearchScopeUtil.isInScope(scope, usage);
