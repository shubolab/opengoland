<idea-plugin>
    <id>dev.openidea.go</id>
    <name>Go Workbench</name>
    <vendor>open Goland contributors</vendor>
    <description><![CDATA[
        Go development tools for the open Goland desktop IDE.
        The isolated platform sandbox is a development environment;
        this plugin is not a redistribution of JetBrains GoLand.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceInterface="com.intellij.ide.plugins.PluginManagementPolicy"
                            serviceImplementation="dev.openidea.goide.product.GoProductPluginManagementPolicy"
                            overrides="true"/>
        <applicationService serviceInterface="com.intellij.lang.IdeLanguageCustomization"
                            serviceImplementation="dev.openidea.goide.navigation.search.GoIdeLanguageCustomization"
                            overrides="true"/>
        <applicationInitializedListener implementation="dev.openidea.goide.lifecycle.StandaloneProxyWarmup"/>
        <actionConfigurationCustomizer implementation="dev.openidea.goide.project.GoNewProjectActionCustomizer"/>
        <notificationGroup id="open Goland Project Creation" displayType="BALLOON" isLogByDefault="true"/>
        <fileType name="open Goland" language="OpenIDEAGo" implementationClass="dev.openidea.goide.lang.GoFileType" fieldName="INSTANCE" extensions="go"/>
        <fileType name="open Goland Module" language="OpenIDEAGoMod" implementationClass="dev.openidea.goide.lang.GoModFileType" fieldName="INSTANCE" patterns="go.mod"/>
        <fileType name="open Goland Workspace" language="OpenIDEAGoWork" implementationClass="dev.openidea.goide.lang.GoWorkFileType" fieldName="INSTANCE" patterns="go.work"/>
        <fileType name="open Goland Fuzz Corpus" language="OpenIDEAGoFuzzCorpus" implementationClass="dev.openidea.goide.run.corpus.GoFuzzCorpusFileType" fieldName="INSTANCE"/>
        <fileTypeDetector implementation="dev.openidea.goide.run.corpus.GoFuzzCorpusFileTypeDetector"/>
        <lang.parserDefinition language="OpenIDEAGo" implementationClass="dev.openidea.goide.lang.GoParserDefinition"/>
        <lang.parserDefinition language="OpenIDEAGoMod" implementationClass="dev.openidea.goide.lang.GoModParserDefinition"/>
        <lang.parserDefinition language="OpenIDEAGoWork" implementationClass="dev.openidea.goide.lang.GoWorkParserDefinition"/>
        <lang.parserDefinition language="OpenIDEAGoFuzzCorpus" implementationClass="dev.openidea.goide.run.corpus.GoFuzzCorpusParserDefinition"/>
        <lang.syntaxHighlighterFactory language="OpenIDEAGo" implementationClass="dev.openidea.goide.lang.GoSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="OpenIDEAGoMod" implementationClass="dev.openidea.goide.lang.GoSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="OpenIDEAGoWork" implementationClass="dev.openidea.goide.lang.GoSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="OpenIDEAGoFuzzCorpus" implementationClass="dev.openidea.goide.lang.GoSyntaxHighlighterFactory"/>
        <lang.commenter language="OpenIDEAGo" implementationClass="dev.openidea.goide.lang.GoCommenter"/>
        <lang.braceMatcher language="OpenIDEAGo" implementationClass="dev.openidea.goide.lang.GoBraceMatcher"/>
        <lang.quoteHandler language="OpenIDEAGo" implementationClass="dev.openidea.goide.lang.GoQuoteHandler"/>
        <typedHandler implementation="dev.openidea.goide.lang.GoQuoteTypedHandler"/>
        <typedHandler implementation="dev.openidea.goide.lang.GoTypedIndentHandler"/>
        <lineIndentProvider implementation="dev.openidea.goide.lang.GoLineIndentProvider"/>
        <enterBetweenBracesDelegate language="OpenIDEAGo" implementationClass="dev.openidea.goide.lang.GoEnterBetweenBracesDelegate"/>
        <enterHandlerDelegate implementation="dev.openidea.goide.lang.GoCommentEnterHandler" order="first"/>
        <enterHandlerDelegate implementation="dev.openidea.goide.lang.GoEnterHandler" order="first"/>
        <lang.foldingBuilder language="OpenIDEAGo" implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder" order="first"/>
        <codeBlockProvider language="OpenIDEAGo" implementationClass="com.redhat.devtools.lsp4ij.features.codeBlockProvider.LSPCodeBlockProvider" order="first"/>
        <codeInsight.parameterInfo language="OpenIDEAGo" implementationClass="com.redhat.devtools.lsp4ij.features.signatureHelp.LSPParameterInfoHandler"/>
        <lang.psiStructureViewFactory language="OpenIDEAGo" implementationClass="dev.openidea.goide.lsp.GoStructureViewFactory"/>
        <callHierarchyProvider language="OpenIDEAGo" implementationClass="dev.openidea.goide.navigation.GoCallHierarchyProvider"/>
        <typeHierarchyProvider language="OpenIDEAGo" implementationClass="dev.openidea.goide.navigation.GoTypeHierarchyProvider"/>
        <targetElementEvaluator language="OpenIDEAGo" implementationClass="dev.openidea.goide.navigation.GoTargetElementEvaluator"/>
        <lang.importOptimizer language="OpenIDEAGo" implementationClass="dev.openidea.goide.semantic.GoImportOptimizer"/>
        <lang.refactoringSupport language="OpenIDEAGo" implementationClass="dev.openidea.goide.refactor.signature.GoRefactoringSupportProvider"/>
        <inlineActionHandler implementation="dev.openidea.goide.refactor.native.GoInlineActionHandler"/>
        <gotoClassContributor id="OpenGolandGoTypeSearchContributor" implementation="dev.openidea.goide.navigation.search.GoTypeSearchContributor"/>
        <notificationGroup id="open Goland Type Search" displayType="BALLOON" isLogByDefault="true"/>
        <testCreator language="OpenIDEAGo" implementationClass="dev.openidea.goide.generate.tests.GoTestCreator"/>
        <testFinder implementation="dev.openidea.goide.generate.tests.GoTestFinder"/>
        <gotoTargetPresentationProvider implementation="dev.openidea.goide.generate.tests.GoTestNavigationPresentationProvider"/>
        <codeInsight.implementMethod language="OpenIDEAGo" implementationClass="dev.openidea.goide.generate.methods.GoImplementMethodsHandler"/>
        <intentionAction>
            <className>dev.openidea.goide.generate.tags.GoStructTagsIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <className>dev.openidea.goide.generate.tags.GoStructTagValuesIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <className>dev.openidea.goide.generate.structs.GoGenerateConstructorIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <className>dev.openidea.goide.generate.structs.GoGenerateGetterIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <className>dev.openidea.goide.generate.structs.GoGenerateSetterIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <className>dev.openidea.goide.generate.structs.GoGenerateGetterSetterIntention</className>
            <category>Go</category>
        </intentionAction>
        <intentionAction>
            <className>dev.openidea.goide.generate.jsonstruct.GoGenerateJsonFieldsIntention</className>
            <category>Go</category>
        </intentionAction>
        <codeInsight.declarativeInlayProvider language="OpenIDEAGo" providerId="opengoland.implement.interface" implementationClass="dev.openidea.goide.generate.methods.GoImplementInterfaceHints" group="OTHER_GROUP" isEnabledByDefault="true" bundle="messages.GoImplementInterfaceHintsBundle" nameKey="inlay.implement.interface.name" descriptionKey="inlay.implement.interface.description"/>
        <codeInsight.inlayActionHandler handlerId="opengoland.implement.interface.click" implementationClass="dev.openidea.goide.generate.methods.GoImplementInterfaceInlayAction"/>
        <renameHandler id="OpenGolandRenameHandler" implementation="dev.openidea.goide.semantic.GoRenameHandler" order="first, before LSPRenameHandler"/>
        <langCodeStyleSettingsProvider implementation="dev.openidea.goide.lang.GoCodeStyleSettingsProvider"/>
        <projectConfigurable id="dev.openidea.go.settings" displayName="Go" instance="dev.openidea.goide.settings.GoSettingsConfigurable"/>
        <projectConfigurable id="dev.openidea.go.lint.settings" parentId="dev.openidea.go.settings" displayName="Go Inspections" instance="dev.openidea.goide.settings.GoLintConfigurable"/>
        <search.optionContributor implementation="dev.openidea.goide.settings.GoSettingsSearchContributor"/>
        <toolWindow id="Go" anchor="left" factoryClass="dev.openidea.goide.engine.GoToolWindowFactory" icon="/icons/go.svg"/>
        <toolWindow id="Go Coverage" anchor="bottom" factoryClass="dev.openidea.goide.coverage.GoCoverageToolWindowFactory" icon="/icons/go.svg"/>
        <toolWindow id="Go Profiles" anchor="bottom" factoryClass="dev.openidea.goide.profile.GoProfileToolWindowFactory" icon="/icons/go.svg"/>
        <toolWindow id="Go Inspections" anchor="bottom" factoryClass="dev.openidea.goide.lint.GoLintToolWindowFactory" icon="/icons/go.svg"/>
        <configurationType implementation="dev.openidea.goide.debug.GoDebugConfigurationType"/>
        <configurationType implementation="dev.openidea.goide.debug.GoLocalAttachConfigurationType"/>
        <configurationType implementation="dev.openidea.goide.debug.GoRemoteDebugConfigurationType"/>
        <configurationType implementation="dev.openidea.goide.run.GoBuildConfigurationType"/>
        <configurationType implementation="dev.openidea.goide.run.GoTestConfigurationType"/>
        <programRunner implementation="dev.openidea.goide.run.GoProgramRunner"/>
        <programRunner implementation="dev.openidea.goide.debug.GoDebugTestRunner"/>
        <runConfigurationProducer implementation="dev.openidea.goide.run.GoBuildConfigurationProducer"/>
        <runConfigurationProducer implementation="dev.openidea.goide.run.GoTestConfigurationProducer"/>
        <runConfigurationProducer implementation="dev.openidea.goide.run.GoBenchmarkConfigurationProducer"/>
        <runConfigurationProducer implementation="dev.openidea.goide.run.GoFuzzConfigurationProducer"/>
        <runConfigurationProducer implementation="dev.openidea.goide.run.corpus.GoFuzzCorpusConfigurationProducer"/>
        <runLineMarkerContributor language="OpenIDEAGo" implementationClass="dev.openidea.goide.run.GoRunLineMarkerContributor"/>
        <runLineMarkerContributor language="OpenIDEAGoFuzzCorpus" implementationClass="dev.openidea.goide.run.corpus.GoFuzzCorpusRunLineMarkerContributor"/>
    </extensions>
    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="openidea.gopls" name="Go (gopls)" factoryClass="dev.openidea.goide.lsp.GoLanguageServerFactory">
            <description><![CDATA[Go code intelligence using the official Go language server.]]></description>
        </server>
        <languageMapping language="OpenIDEAGo" serverId="openidea.gopls" languageId="go"/>
        <languageMapping language="OpenIDEAGoMod" serverId="openidea.gopls" languageId="go.mod"/>
        <languageMapping language="OpenIDEAGoWork" serverId="openidea.gopls" languageId="go.work"/>
        <debugAdapterServer id="openidea.delve" name="Go (Delve)" factoryClass="dev.openidea.goide.debug.GoDebugAdapterFactory" icon="/icons/go.svg"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <localTerminalCustomizer implementation="dev.openidea.goide.terminal.GoTerminalCustomizer"/>
        <commandSpecsProvider implementation="dev.openidea.goide.terminal.GoShellCommandSpecsProvider"/>
    </extensions>
    <actions>
        <action id="OpenIDEA.InstallChineseLanguagePack" class="dev.openidea.goide.plugins.InstallChineseLanguagePackAction" text="安装简体中文语言包… / Install Chinese Language Pack…" description="从 JetBrains 官方获取与当前平台匹配的简体中文语言包">
            <add-to-group group-id="HelpMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.TypeFromJson" class="dev.openidea.goide.generate.jsonstruct.GoGenerateJsonTypeAction" text="Type from JSON…" description="Analyze a JSON sample and preview Go types">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.FieldsFromJson" class="dev.openidea.goide.generate.jsonstruct.GoGenerateJsonFieldsAction" text="Struct Fields from JSON…" description="Preview JSON-derived fields without replacing existing fields">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.GenerateConstructor" class="dev.openidea.goide.generate.structs.GoGenerateConstructorAction" text="Constructor…" description="Preview a Go struct constructor">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.GenerateGetter" class="dev.openidea.goide.generate.structs.GoGenerateGetterAction" text="Getter…" description="Preview Go struct getters">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.GenerateSetter" class="dev.openidea.goide.generate.structs.GoGenerateSetterAction" text="Setter…" description="Preview Go struct setters">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.GenerateGetterSetter" class="dev.openidea.goide.generate.structs.GoGenerateGetterSetterAction" text="Getter and Setter…" description="Preview Go struct getters and setters">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.StructTags" class="dev.openidea.goide.generate.tags.GoStructTagsAction" text="Struct Tags…" description="Preview changes to Go struct field tags">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.GenerateTests" class="dev.openidea.goide.generate.tests.GoGenerateTestsAction" text="Go Tests…" description="Generate typed Go tests with native preview and Undo">
            <add-to-group group-id="CodeMenu" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.GenerateEmptyTestFile" class="dev.openidea.goide.generate.tests.GoGenerateEmptyTestFileAction" text="Empty test file" description="Preview a Go test scaffold">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.GenerateFunctionTest" class="dev.openidea.goide.generate.tests.GoGenerateFunctionTestAction" text="Test for function" description="Preview Go tests for the current function or method">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.GenerateFileTests" class="dev.openidea.goide.generate.tests.GoGenerateFileTestsAction" text="Tests for file" description="Preview Go tests for declarations in the current file">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.GeneratePackageTests" class="dev.openidea.goide.generate.tests.GoGeneratePackageTestsAction" text="Tests for package" description="Preview Go tests for declarations in the current package">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <action id="OpenIDEA.Go.Refactor" class="dev.openidea.goide.semantic.GoRefactorAction" text="Go Refactor…" description="Preview Go refactorings for the current selection">
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
        </action>
        <action id="OpenIDEA.NewGoModule" class="dev.openidea.goide.project.NewGoModuleAction" text="Go Module…" description="Create a new Go module">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
        <group id="OpenIDEA.Go.Tools" text="Go" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="OpenIDEA.Go.Tidy" class="dev.openidea.goide.engine.GoTidyAction" text="Go Mod Tidy"/>
            <action id="OpenIDEA.Go.Download" class="dev.openidea.goide.engine.GoDownloadAction" text="Download Go Modules"/>
            <action id="OpenIDEA.Go.Vendor" class="dev.openidea.goide.engine.GoVendorAction" text="Vendor Go Dependencies"/>
            <action id="OpenIDEA.Go.WorkSync" class="dev.openidea.goide.engine.GoWorkSyncAction" text="Sync Go Workspace"/>
            <separator/>
            <action id="OpenIDEA.Go.Vet" class="dev.openidea.goide.lint.RunGoVetInspectionAction" text="Go Vet"/>
            <action id="OpenIDEA.Go.GolangciLint" class="dev.openidea.goide.lint.RunGolangciInspectionAction" text="Run golangci-lint"/>
            <action id="OpenIDEA.Go.Generate" class="dev.openidea.goide.engine.GoGenerateAction" text="Go Generate"/>
            <action id="OpenIDEA.Go.Benchmark" class="dev.openidea.goide.engine.GoBenchmarkAction" text="Run Go Benchmarks"/>
            <separator/>
            <action id="OpenIDEA.Go.Coverage" class="dev.openidea.goide.coverage.RunGoCoverageAction" text="Run Go Coverage"/>
            <action id="OpenIDEA.Go.ImportCoverage" class="dev.openidea.goide.coverage.ImportGoCoverageAction" text="Import Go Coverage Profile…"/>
            <action id="OpenIDEA.Go.HideCoverage" class="dev.openidea.goide.coverage.HideGoCoverageAction" text="Hide Go Coverage"/>
            <separator/>
            <action id="OpenIDEA.Go.Profiles" class="dev.openidea.goide.profile.ShowGoProfilesAction" text="Go Profiles…"/>
            <action id="OpenIDEA.Go.ImportProfile" class="dev.openidea.goide.profile.ImportGoProfileAction" text="Import Go pprof Profile…"/>
        </group>
    </actions>
</idea-plugin>
